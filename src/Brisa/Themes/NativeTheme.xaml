<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Brisa.Controls">
    <!-- Keep Microsoft's Fluent templates and their hover/focus/disabled states.
         Implicit styles without these bases fall back to legacy Aero controls. -->
    <Style TargetType="Window" BasedOn="{StaticResource DefaultWindowStyle}">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Background" Value="{DynamicResource NativeBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource NativeForeground}"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
      <Setter Property="Padding" Value="18,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="MinWidth" Value="90"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="ToolbarAction" TargetType="controls:ToolbarButton">
      <!-- Template próprio: o do Fluent desenha borda e preenchimento no estado desabilitado, e um
           ícone indisponível ficava mais chamativo que um disponível. Os estados usam camadas com
           opacidade animada, então dá para verificá-los fora da tela com GoToState. -->
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="{DynamicResource NativeForeground}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="controls:ToolbarButton">
            <Grid x:Name="Root">
              <Border x:Name="Hover" Background="{DynamicResource NativeIconSurfaceHover}" CornerRadius="4" Opacity="0"/>
              <Border x:Name="Press" Background="{DynamicResource NativeIconSurfacePressed}" CornerRadius="4" Opacity="0"/>
              <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="4">
                <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <!-- O anel de foco usa a cor de texto, não o salmão de ação. -->
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NativeForeground}"/>
              </Trigger>
              <!-- Estados escritos pelo próprio botão (ver Controls/ToolbarButton.cs). Gatilho pinta
                   de forma síncrona, então o mesmo valor pode ser verificado fora da tela. -->
              <Trigger Property="State" Value="MouseOver">
                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                <Setter TargetName="Press" Property="Opacity" Value="0"/>
                <Setter TargetName="Glyph" Property="Opacity" Value="1"/>
              </Trigger>
              <!-- Pressionado precisa de um segundo sinal além do preenchimento: o glifo cai para
                   0.8 e o fundo dá mais um passo, senão hover e pressionado ficam iguais. -->
              <Trigger Property="State" Value="Pressed">
                <Setter TargetName="Hover" Property="Opacity" Value="0"/>
                <Setter TargetName="Press" Property="Opacity" Value="1"/>
                <Setter TargetName="Glyph" Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="State" Value="Normal">
                <Setter TargetName="Glyph" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="State" Value="Disabled">
                <Setter TargetName="Hover" Property="Opacity" Value="0"/>
                <Setter TargetName="Press" Property="Opacity" Value="0"/>
                <Setter TargetName="Glyph" Property="Opacity" Value="1"/>
                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>

          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
      <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,7"/>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
      <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,7"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"/>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}"/>
    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}"/>
    <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}"/>
    <Style TargetType="ListBox" BasedOn="{StaticResource DefaultListBoxStyle}"/>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
      <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style x:Key="SettingsSurface" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource NativeSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource NativeStroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SecondaryText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource NativeSecondary}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
</ResourceDictionary>
