<Window x:Class="Brisa.RouteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Route" Width="420" Height="520" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Style="{StaticResource PageTitle}" Text="Choose Route"/><TextBlock Style="{StaticResource SecondaryText}" Margin="0,5,0,20" Text="Choose automatically, or select a country to optimize within that location."/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource SettingsSurface}" Padding="4">
      <ListBox x:Name="CountryList" AutomationProperties.Name="Route country" SelectedIndex="0" BorderThickness="0" Background="Transparent">
        <ListBoxItem Content="Automatic" Tag=""/><ListBoxItem Content="Brazil" Tag="BR"/><ListBoxItem Content="Canada" Tag="CA"/><ListBoxItem Content="Germany" Tag="DE"/><ListBoxItem Content="Japan" Tag="JP"/><ListBoxItem Content="Netherlands" Tag="NL"/><ListBoxItem Content="United States" Tag="US"/>
      </ListBox>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Click="Cancel_Click" Content="Cancel" IsCancel="True" MinWidth="90"/>
      <Button Style="{StaticResource PrimaryAction}" Margin="8,0,0,0" Click="Select_Click" Content="Use Route" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
