<UserControl x:Class="Brisa.AccountView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Brisa.Localization"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <UserControl.Resources>
    <!-- Secondary link: underline at rest, a quiet surface on hover and press, and a focus ring
         that replaces the padding instead of adding to it, so nothing shifts. -->
    <Style x:Key="AccountLinkButton" TargetType="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Margin" Value="-8,0,12,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource NativeLinkForeground}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <TextBlock x:Name="LinkLabel" Text="{TemplateBinding Content}" TextDecorations="Underline"
                         VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NativeIconSurfaceHover}"/>
                <Setter Property="Foreground" Value="{DynamicResource NativeLinkForegroundPointerOver}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NativeIconSurfacePressed}"/>
                <Setter Property="Foreground" Value="{DynamicResource NativeLinkForegroundPointerOver}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NativeForeground}"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Bd" Property="Padding" Value="6,2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundDisabled}"/>
                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                <Setter TargetName="LinkLabel" Property="TextDecorations" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock x:Name="Subtitle" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
      <StackPanel x:Name="RegistrationPanel" Margin="0,6,0,0">
        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
          <Run Text="{loc:Loc NewToProton}"/> <Hyperlink x:Name="SignUpLink" NavigateUri="https://account.protonvpn.com/signup?plan=free" RequestNavigate="SignUp_RequestNavigate" AutomationProperties.Name="{loc:Loc CreateAccount}"><Run Text="{loc:Loc CreateFreeAccount}"/></Hyperlink>
        </TextBlock>
        <TextBlock x:Name="RegistrationHelp" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource SettingsSurface}">
      <Grid>
        <Grid x:Name="SignedOutPanel" VerticalAlignment="Top">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{loc:Loc Username}"/>
          <TextBox x:Name="UsernameBox" Grid.Row="1" Margin="0,6,0,18" AutomationProperties.Name="{loc:Loc ProtonUsername}"/>
          <TextBlock Grid.Row="2" Text="{loc:Loc Password}"/>
          <PasswordBox x:Name="PasswordInput" Grid.Row="3" Margin="0,6,0,0" AutomationProperties.Name="{loc:Loc ProtonPassword}"/>
          <StackPanel x:Name="TwoFactorPanel" Grid.Row="4" Margin="0,18,0,0" Visibility="Collapsed"><TextBlock Text="{loc:Loc TwoFactorCode}"/><PasswordBox x:Name="TwoFactorInput" Margin="0,6,0,0" AutomationProperties.Name="{loc:Loc TwoFactorCode}" MaxLength="12"/></StackPanel>
        </Grid>
        <StackPanel x:Name="SignedInPanel" Visibility="Collapsed">
          <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Loc SignedInAs}"/>
          <TextBlock x:Name="UsernameText" Margin="0,7,0,0" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Style="{StaticResource SecondaryText}" Margin="0,18,0,0" Text="{loc:Loc CredentialsHelper}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="0,20,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="UseConfFile" Style="{StaticResource AccountLinkButton}" Content="{loc:Loc UseConfFile}" Click="UseConfFile_Click"
              HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc UseConfFile}"/>
      <Button x:Name="ActionButton" Grid.Column="1" Style="{StaticResource PrimaryAction}" HorizontalAlignment="Right" Click="Action_Click" IsDefault="True"/>
    </Grid>
  </Grid>
</UserControl>
