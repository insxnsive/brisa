<UserControl x:Class="Brisa.AccountView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Brisa.Localization"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock x:Name="Subtitle" Style="{StaticResource SecondaryText}" Text="{loc:Loc SignInHelper}"/>
      <StackPanel x:Name="RegistrationPanel" Margin="0,6,0,0">
        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
          New to Proton? <Hyperlink x:Name="SignUpLink" NavigateUri="https://account.protonvpn.com/signup?plan=free" RequestNavigate="SignUp_RequestNavigate" AutomationProperties.Name="{loc:Loc CreateAccount}">Create a Free Account</Hyperlink>
        </TextBlock>
        <TextBlock x:Name="RegistrationHelp" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource SettingsSurface}">
      <Grid>
        <Grid x:Name="SignedOutPanel" VerticalAlignment="Top">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{loc:Loc Username}"/>
          <TextBox x:Name="UsernameBox" Grid.Row="1" Margin="0,6,0,18" AutomationProperties.Name="{loc:Loc ProtonUsername}"/>
          <TextBlock Grid.Row="2" Text="{loc:Loc Password}"/>
          <PasswordBox x:Name="PasswordInput" Grid.Row="3" Margin="0,6,0,0" AutomationProperties.Name="{loc:Loc ProtonPassword}"/>
          <StackPanel x:Name="TwoFactorPanel" Grid.Row="4" Margin="0,18,0,0" Visibility="Collapsed"><TextBlock Text="{loc:Loc TwoFactorCode}"/><PasswordBox x:Name="TwoFactorInput" Margin="0,6,0,0" AutomationProperties.Name="{loc:Loc TwoFactorCode}" MaxLength="12"/></StackPanel>
        </Grid>
        <StackPanel x:Name="SignedInPanel" Visibility="Collapsed">
          <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Loc SignedInAs}"/>
          <TextBlock x:Name="UsernameText" Margin="0,7,0,0" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Style="{StaticResource SecondaryText}" Margin="0,18,0,0" Text="{loc:Loc CredentialsHelper}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="0,20,0,0">
      <Button x:Name="ActionButton" Style="{StaticResource PrimaryAction}" HorizontalAlignment="Right" Click="Action_Click" Content="{loc:Loc SignIn}" IsDefault="True"/>
    </Grid>
  </Grid>
</UserControl>
