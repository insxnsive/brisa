<Window x:Class="Brisa.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Brisa.Controls"
        Title="Brisa" Width="460" Height="540" MinWidth="440" MinHeight="520" MaxWidth="560" WindowStartupLocation="CenterScreen">
  <Grid Margin="24,20,24,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <controls:ToolbarButton x:Name="BackButton" Style="{StaticResource ToolbarAction}" Visibility="Collapsed" Margin="0,0,8,0" Click="Back_Click" ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72B;"/></controls:ToolbarButton>
      <TextBlock x:Name="PageTitle" Grid.Column="1" Style="{StaticResource PageTitle}" VerticalAlignment="Center" Visibility="Collapsed"/>
      <StackPanel x:Name="HomeActions" Grid.Column="2" Orientation="Horizontal">
        <controls:ToolbarButton x:Name="AccountButton" Style="{StaticResource ToolbarAction}" ToolTip="Account" AutomationProperties.Name="Account" Click="Account_Click" Margin="0,0,4,0"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE77B;"/></controls:ToolbarButton>
        <controls:ToolbarButton x:Name="SettingsButton" Style="{StaticResource ToolbarAction}" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;"/></controls:ToolbarButton>
      </StackPanel>
    </Grid>
    <Grid x:Name="HomeContent" Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="ConnectionSurface" Grid.Row="0" Style="{StaticResource SettingsSurface}" Margin="0,20,0,20" Padding="20">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
        <StackPanel x:Name="StatusBlock" VerticalAlignment="Center" Margin="0,0,0,16">
          <Border x:Name="StatusBadge" Width="56" Height="56" CornerRadius="28" Background="{DynamicResource NativeIconSurface}" HorizontalAlignment="Center">
            <TextBlock x:Name="StatusIcon" FontFamily="Segoe Fluent Icons" FontSize="24" Text="&#xE785;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="StatusText" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.HelpText="Connection status" Margin="0,14,0,0" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Checking status…"/>
          <TextBlock x:Name="DetailText" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextAlignment="Center" MinHeight="38"/>
          <ProgressBar x:Name="ConnectionProgress" AutomationProperties.Name="Connection in progress" Width="104" Height="4" Margin="0,8,0,0" Visibility="Hidden" IsIndeterminate="False" HorizontalAlignment="Center"/>
        </StackPanel>
        <!-- Conectado: o status encolhe para uma linha de cabeçalho alinhada à esquerda e o painel
             de detalhes ocupa o espaço que o bloco centralizado usava. Desconectado não mostra
             painel nenhum: zero e travessão são piores que a ausência do dado. -->
        <StackPanel x:Name="DetailsHost" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,0,0,16">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="CompactBadge" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource NativeStatusConnectedSurface}">
              <TextBlock x:Name="CompactIcon" FontFamily="Segoe Fluent Icons" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE73E;"/>
            </Border>
            <TextBlock x:Name="CompactStatusText" Margin="12,0,0,0" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Connection status" Text="Connected"/>
          </StackPanel>
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock FontSize="11" Opacity=".75" Text="Connected for"/><TextBlock x:Name="DurationValue" Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" AutomationProperties.Name="Connected for" Text="0:00"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock FontSize="11" Opacity=".75" Text="Total traffic"/><TextBlock x:Name="TrafficValue" Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" AutomationProperties.Name="Total traffic" Text="0 B"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock FontSize="11" Opacity=".75" Text="Protocol"/><TextBlock Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Text="WireGuard (UDP)"/></StackPanel>
          </Grid>
          <Border Margin="0,12,0,0" Style="{StaticResource SettingsSurface}" Padding="12">
            <StackPanel>
              <Grid>
                <TextBlock FontSize="12" Opacity=".75" VerticalAlignment="Center" Text="Discord traffic"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center" Text="&#xE896;" Foreground="{DynamicResource NativeStatusConnected}" AutomationProperties.Name="Download"/>
                  <TextBlock x:Name="DownRateText" Margin="4,0,0,0" MinWidth="76" TextAlignment="Right" Typography.NumeralAlignment="Tabular" FontSize="12" VerticalAlignment="Center" AutomationProperties.Name="Download rate" Text="0 B/s"/>
                  <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" Text="&#xE898;" Foreground="{DynamicResource NativeChartLine}" AutomationProperties.Name="Upload"/>
                  <TextBlock x:Name="UpRateText" Margin="4,0,0,0" MinWidth="76" TextAlignment="Right" Typography.NumeralAlignment="Tabular" FontSize="12" Opacity=".75" VerticalAlignment="Center" AutomationProperties.Name="Upload rate" Text="0 B/s"/>
                </StackPanel>
              </Grid>
              <Grid x:Name="ChartHost" Height="56" Margin="0,8,0,0" ClipToBounds="True" AutomationProperties.Name="Discord traffic chart">
                <Canvas x:Name="ChartCanvas" ClipToBounds="True">
                  <Polygon x:Name="DownArea" Fill="{DynamicResource NativeChartFill}" Stroke="{DynamicResource NativeStatusConnected}" StrokeThickness="1.5" StrokeLineJoin="Round" Points=""/>
                  <Polyline x:Name="UpLine" Stroke="{DynamicResource NativeChartLine}" StrokeThickness="1.5" StrokeDashArray="3 3" Points=""/>
                </Canvas>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
        </Grid>
        <Button x:Name="RouteButton" Grid.Row="1" AutomationProperties.Name="Choose route" Click="Route_Click" Padding="14,10" HorizontalContentAlignment="Stretch">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="RouteDetails"><TextBlock FontSize="12" Opacity=".75" Text="Route"/><TextBlock x:Name="RouteText" Margin="0,2,12,0" FontSize="14" Text="Automatic" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RouteServerText" Margin="0,3,12,0" FontSize="12" Style="{StaticResource SecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/><TextBlock x:Name="RouteHelper" Margin="0,4,12,0" FontSize="12" Style="{StaticResource SecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Disconnect to change the route" Visibility="Collapsed"/></StackPanel>
            <TextBlock x:Name="RouteChevron" Grid.Column="1" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center" Text="&#xE76C;"/>
          </Grid>
        </Button>
      </Grid>
    </Border>
    <Button x:Name="PrimaryButton" Grid.Row="1" Style="{StaticResource PrimaryAction}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" IsEnabled="False" MinHeight="40" Click="Primary_Click" Content="Connect"/>
    </Grid>
    <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
</Window>
