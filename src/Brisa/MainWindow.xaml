<Window x:Class="Brisa.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brisa" Width="460" Height="540" MinWidth="440" MinHeight="520" MaxWidth="560" WindowStartupLocation="CenterScreen">
  <Grid Margin="24,20,24,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Style="{StaticResource ToolbarAction}" Visibility="Collapsed" Margin="0,0,8,0" Click="Back_Click" ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back to Connection"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72B;"/></Button>
      <TextBlock x:Name="PageTitle" Grid.Column="1" Style="{StaticResource PageTitle}" VerticalAlignment="Center" Text="Connection"/>
      <StackPanel x:Name="HomeActions" Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="AccountButton" Style="{StaticResource ToolbarAction}" ToolTip="Account" AutomationProperties.Name="Account" Click="Account_Click" Margin="0,0,4,0"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE77B;"/></Button>
        <Button x:Name="SettingsButton" Style="{StaticResource ToolbarAction}" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;"/></Button>
      </StackPanel>
    </Grid>
    <Grid x:Name="HomeContent" Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="ConnectionSurface" Grid.Row="0" Style="{StaticResource SettingsSurface}" Margin="0,20,0,20" Padding="20">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,0,16">
          <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource NativeIconSurface}" HorizontalAlignment="Center">
            <TextBlock x:Name="StatusIcon" FontFamily="Segoe Fluent Icons" FontSize="24" Text="&#xE785;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="StatusText" AutomationProperties.Name="Connection status" Margin="0,14,0,0" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Checking status…"/>
          <TextBlock x:Name="DetailText" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextAlignment="Center" MinHeight="38"/>
        </StackPanel>
        <Button x:Name="RouteButton" Grid.Row="1" AutomationProperties.Name="Choose route" Click="Route_Click" Padding="14,10" HorizontalContentAlignment="Stretch">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock FontSize="12" Opacity=".75" Text="Route"/><TextBlock x:Name="RouteText" Margin="0,2,12,0" FontSize="14" Text="Automatic" TextTrimming="CharacterEllipsis"/></StackPanel>
            <TextBlock Grid.Column="1" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center" Text="&#xE76C;"/>
          </Grid>
        </Button>
      </Grid>
    </Border>
    <Button x:Name="PrimaryButton" Grid.Row="1" Style="{StaticResource PrimaryAction}" AutomationProperties.Name="Connect or disconnect" IsEnabled="False" MinHeight="40" Click="Primary_Click" Content="Connect"/>
    </Grid>
    <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
</Window>
