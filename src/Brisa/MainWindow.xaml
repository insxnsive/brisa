<Window x:Class="Brisa.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Brisa.Localization" xmlns:controls="clr-namespace:Brisa.Controls"
        Title="Brisa" Width="460" Height="540" MinWidth="440" MinHeight="520" MaxWidth="560" WindowStartupLocation="CenterScreen">
  <Grid Margin="24,20,24,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <controls:ToolbarButton x:Name="BackButton" Style="{StaticResource ToolbarAction}" Visibility="Collapsed" Margin="0,0,8,0" Click="Back_Click" ToolTip="{loc:Loc Back (Alt+Left)}" AutomationProperties.Name="{loc:Loc Back}"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72B;"/></controls:ToolbarButton>
      <TextBlock x:Name="PageTitle" Grid.Column="1" Style="{StaticResource PageTitle}" VerticalAlignment="Center" Visibility="Collapsed"/>
      <StackPanel x:Name="HomeActions" Grid.Column="2" Orientation="Horizontal">
        <controls:ToolbarButton x:Name="AccountButton" Style="{StaticResource ToolbarAction}" ToolTip="{loc:Loc Account}" AutomationProperties.Name="{loc:Loc Account}" Click="Account_Click" Margin="0,0,4,0"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE77B;"/></controls:ToolbarButton>
        <controls:ToolbarButton x:Name="SettingsButton" Style="{StaticResource ToolbarAction}" ToolTip="{loc:Loc SettingsTitle}" AutomationProperties.Name="{loc:Loc SettingsTitle}" Click="Settings_Click"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;"/></controls:ToolbarButton>
      </StackPanel>
    </Grid>
    <Grid x:Name="HomeContent" Grid.Row="1" Focusable="True" FocusVisualStyle="{x:Null}">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="ConnectionSurface" Grid.Row="0" Style="{StaticResource SettingsSurface}" Margin="0,20,0,20" Padding="20">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
        <StackPanel x:Name="StatusBlock" VerticalAlignment="Center" Margin="0,0,0,16">
          <Grid HorizontalAlignment="Center" Width="64" Height="64">
            <!-- Anel neutro de progresso: um arco gira em volta do selo. Antes era um traço salmão
                 solto embaixo do texto, que lia como artefato em vez de "conectando". -->
            <Ellipse x:Name="StatusRing" Width="64" Height="64" StrokeThickness="2" StrokeDashArray="30 70"
                     Stroke="{DynamicResource NativeChartLine}" Visibility="Collapsed"
                     RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="{loc:Loc ConnectionInProgress}">
              <Ellipse.RenderTransform><RotateTransform x:Name="StatusRingRotation"/></Ellipse.RenderTransform>
            </Ellipse>
            <Border x:Name="StatusBadge" Width="56" Height="56" CornerRadius="28" Background="{DynamicResource NativeIconSurface}" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock x:Name="StatusIcon" FontFamily="Segoe Fluent Icons" FontSize="24" Text="&#xE785;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <Grid Margin="0,14,0,0">
            <TextBlock x:Name="StatusTextGhost" AutomationProperties.IsOffscreenBehavior="Offscreen" IsHitTestVisible="False" Visibility="Collapsed" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Text=""/>
            <TextBlock x:Name="StatusText" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.HelpText="{loc:Loc ConnectionStatus}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Checking status…"/>
          </Grid>
          <TextBlock x:Name="DetailText" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextAlignment="Center" MinHeight="38"/>
        </StackPanel>
        <!-- Conectado: o status encolhe para uma linha de cabeçalho alinhada à esquerda e o painel
             de detalhes ocupa o espaço que o bloco centralizado usava. Desconectado não mostra
             painel nenhum: zero e travessão são piores que a ausência do dado. -->
        <StackPanel x:Name="DetailsHost" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,0,0,16">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="CompactBadge" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource NativeStatusConnectedSurface}">
              <TextBlock x:Name="CompactIcon" FontFamily="Segoe Fluent Icons" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE73E;"/>
            </Border>
            <TextBlock x:Name="CompactStatusText" Margin="12,0,0,0" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc ConnectionStatus}" Text="{loc:Loc StatusConnected}"/>
          </StackPanel>
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock FontSize="11" Opacity=".75" Text="{loc:Loc ConnectedFor}"/><TextBlock x:Name="DurationValue" Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" AutomationProperties.Name="{loc:Loc ConnectedFor}" Text="0:00"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock FontSize="11" Opacity=".75" Text="{loc:Loc TotalTraffic}"/><TextBlock x:Name="TrafficValue" Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" AutomationProperties.Name="{loc:Loc TotalTraffic}" Text="0 B"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock FontSize="11" Opacity=".75" Text="{loc:Loc Protocol}"/><TextBlock Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Text="WireGuard (UDP)"/></StackPanel>
          </Grid>
          <Border Margin="0,12,0,0" Style="{StaticResource SettingsSurface}" Padding="12">
            <StackPanel>
              <Grid>
                <TextBlock FontSize="12" Opacity=".75" VerticalAlignment="Center" Text="{loc:Loc DiscordTraffic}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center" Text="&#xE896;" Foreground="{DynamicResource NativeStatusConnected}" AutomationProperties.Name="{loc:Loc Download}"/>
                    <TextBlock x:Name="DownRateText" Margin="4,0,0,0" Typography.NumeralAlignment="Tabular" FontSize="12" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc DownloadRate}" Text="0 B/s"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center" Text="&#xE898;" Foreground="{DynamicResource NativeChartLine}" AutomationProperties.Name="{loc:Loc Upload}"/>
                    <TextBlock x:Name="UpRateText" Margin="4,0,0,0" Typography.NumeralAlignment="Tabular" FontSize="12" Opacity=".75" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc UploadRate}" Text="0 B/s"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
              <Grid x:Name="ChartHost" Height="56" Margin="0,8,0,0" ClipToBounds="True" AutomationProperties.Name="{loc:Loc DiscordTrafficChart}">
                <Canvas x:Name="ChartCanvas" ClipToBounds="True">
                  <Polygon x:Name="DownArea" Fill="{DynamicResource NativeChartFill}" Stroke="{x:Null}" StrokeThickness="0" Points=""/>
                  <Polyline x:Name="DownLine" Stroke="{DynamicResource NativeStatusConnected}" StrokeThickness="1.5" StrokeLineJoin="Round" Points=""/>
                  <Polyline x:Name="UpLine" Stroke="{DynamicResource NativeChartLine}" StrokeThickness="1.5" StrokeDashArray="3 3" Points=""/>
                </Canvas>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
        </Grid>
        <Border x:Name="RouteCard" Grid.Row="1" Background="Transparent" ToolTipService.InitialShowDelay="300">
        <Button x:Name="RouteButton" AutomationProperties.Name="{loc:Loc ChooseRoute}" Click="Route_Click" Padding="14,10" HorizontalContentAlignment="Stretch">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="RouteDetails"><TextBlock FontSize="12" Opacity=".75" Text="{loc:Loc Route}"/><TextBlock x:Name="RouteText" Margin="0,2,12,0" FontSize="14" Text="{loc:Loc Automatic}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RouteServerText" Margin="0,3,12,0" FontSize="12" Style="{StaticResource SecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/></StackPanel>
            <TextBlock x:Name="RouteChevron" Grid.Column="1" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center" Text="&#xE76C;"/>
          </Grid>
        </Button>
        </Border>
      </Grid>
    </Border>
    <Button x:Name="PrimaryButton" Grid.Row="1" Style="{StaticResource PrimaryAction}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" IsEnabled="False" MinHeight="40" Click="Primary_Click" Content="{loc:Loc Connect}"/>
    </Grid>
    <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
</Window>
