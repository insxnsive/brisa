<UserControl x:Class="Brisa.RouteView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Brisa.Localization"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <UserControl.Resources>
    <Style x:Key="RouteRow" TargetType="ListBoxItem">
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="Row" Background="Transparent" CornerRadius="6" MinHeight="40" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="Focus" CornerRadius="6" BorderBrush="{DynamicResource NativeForeground}" BorderThickness="1"
                      Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="RouteRowContent">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <Grid Grid.Column="1">
          <TextBlock Text="{Binding PingText}" Visibility="{Binding PingVisibility}" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Foreground="{DynamicResource NativeSecondary}" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding DotsVisibility}">
            <Ellipse Width="4" Height="4" Margin="0,0,3,0" Fill="{DynamicResource NativeSecondary}" Opacity="0.25"/>
            <Ellipse Width="4" Height="4" Margin="0,0,3,0" Fill="{DynamicResource NativeSecondary}" Opacity="0.6"/>
            <Ellipse Width="4" Height="4" Fill="{DynamicResource NativeSecondary}" Opacity="0.25"/>
          </StackPanel>
        </Grid>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="HelperText" Grid.Row="0" Style="{StaticResource SecondaryText}" Text="{loc:Loc ChooseRouteHelper}" TextWrapping="Wrap"/>
    <TextBlock x:Name="CurrentRouteText" Grid.Row="1" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
    <Border Grid.Row="2" Style="{StaticResource SettingsSurface}" Padding="4" Margin="0,12,0,0">
      <Grid x:Name="RouteTrack">
        <Border x:Name="HoverIndicator" CornerRadius="6" Background="{DynamicResource NativeIconSurfaceHover}" Opacity="0"
                IsHitTestVisible="False" VerticalAlignment="Top" Height="40">
          <Border.RenderTransform><TranslateTransform x:Name="HoverTranslate"/></Border.RenderTransform>
        </Border>
        <Border x:Name="SelectionIndicator" CornerRadius="6" Background="{DynamicResource NativeIconSurfacePressed}"
                BorderBrush="{DynamicResource NativeStroke}" BorderThickness="1" IsHitTestVisible="False" VerticalAlignment="Top" Height="40">
          <Border.RenderTransform><TranslateTransform x:Name="SelectionTranslate"/></Border.RenderTransform>
        </Border>
        <ListBox x:Name="CountryList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource RouteRow}"
                 ItemTemplate="{StaticResource RouteRowContent}" AutomationProperties.Name="{loc:Loc RouteCountry}"/>
      </Grid>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="CancelButton" Click="Cancel_Click" Content="{loc:Loc Cancel}" IsCancel="True" MinWidth="90"/>
      <Button x:Name="UseRouteButton" Style="{StaticResource PrimaryAction}" Margin="8,0,0,0" Click="UseRoute_Click" Content="{loc:Loc UseRoute}" IsDefault="True"/>
    </StackPanel>
  </Grid>
</UserControl>
