<UserControl x:Class="Brisa.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,16" Text="Appearance, startup, and updates."/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <Border Style="{StaticResource SettingsSurface}">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Theme"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <RadioButton x:Name="SystemTheme" GroupName="Theme" Content="System" Margin="0,0,22,0"/>
            <RadioButton x:Name="LightTheme" GroupName="Theme" Content="Light" Margin="0,0,22,0"/>
            <RadioButton x:Name="DarkTheme" GroupName="Theme" Content="Dark"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SettingsSurface}" Margin="0,8,0,0">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Behavior" Margin="0,0,0,12"/>
          <CheckBox x:Name="StartupBox" Content="Start When I Sign In"/>
          <TextBlock Style="{StaticResource SecondaryText}" Margin="0,12,0,0" FontSize="12" Text="Closing the window keeps Brisa connected in the tray. Choose Exit from the tray menu to disconnect and quit."/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SettingsSurface}" Margin="0,8,0,0" Padding="12">
        <Expander x:Name="UpdatesExpander" Header="About and Updates" IsExpanded="False">
        <StackPanel Margin="0,10,0,0">
          <TextBlock x:Name="VersionText" FontWeight="SemiBold"/>
          <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0" FontSize="12" Text="GPL-3.0-or-later · No warranty. Redistribution allowed under the included LICENSE." TextWrapping="Wrap"/>
          <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap">
            Forked from GoLiveBypass by bezumiya and contributors. <Hyperlink NavigateUri="https://github.com/insxnsive/brisa" RequestNavigate="Source_RequestNavigate">Source and license</Hyperlink>
          </TextBlock>
          <TextBlock x:Name="UpdateStatusText" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.Name="Update status"/>
          <ProgressBar x:Name="UpdateProgress" Margin="0,8,0,0" Height="3" Minimum="0" Maximum="100" Visibility="Collapsed"/>
          <WrapPanel Margin="0,8,0,0">
            <Button x:Name="CheckUpdateButton" Click="CheckUpdate_Click" Content="Check for Updates"/>
            <Button x:Name="RestartUpdateButton" Style="{StaticResource PrimaryAction}" Margin="8,0,0,0" Click="RestartUpdate_Click" Content="Restart to Update" Visibility="Collapsed"/>
          </WrapPanel>
        </StackPanel>
        </Expander>
      </Border>
    </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Click="Advanced_Click" Content="Advanced…" ToolTip="Import a configuration or view diagnostics"/>
      <Button x:Name="CancelButton" Grid.Column="2" Click="Cancel_Click" Content="Cancel" MinWidth="80"/>
      <Button x:Name="SaveButton" Grid.Column="3" Style="{StaticResource PrimaryAction}" Margin="8,0,0,0" Click="Save_Click" Content="Save" IsDefault="True"/>
    </Grid>
  </Grid>
</UserControl>
