<UserControl x:Class="Brisa.AdvancedView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <!-- A página rola: com os créditos abertos o conteúdo passa da altura mínima da janela, e sem
       rolagem o botão de atualização saía da vista. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
    <StackPanel>
      <TextBlock Style="{StaticResource SecondaryText}" Text="Import a profile or view sanitized diagnostics."/>
      <WrapPanel Margin="0,16,0,0">
        <Button x:Name="ImportButton" Click="Import_Click" ToolTip="Choose a WireGuard configuration file">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8E5;" VerticalAlignment="Center"/><TextBlock Margin="8,0,0,0" Text="Import Configuration"/></StackPanel>
        </Button>
        <Button x:Name="DiagnosticsButton" Margin="8,0,0,0" Click="Diagnostics_Click" Content="Refresh Diagnostics"/>
      </WrapPanel>
      <TextBox x:Name="DiagnosticsBox" Margin="0,16,0,0" Height="110" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               FontFamily="Cascadia Mono, Consolas" FontSize="12" AutomationProperties.Name="Diagnostics" Text="Diagnostics have not been loaded."/>
      <!-- Versão, atualização e créditos moram aqui: são informação sobre o app, não uma
           preferência, e Settings fica só com o que o usuário escolhe. -->
      <Border Style="{StaticResource SettingsSurface}" Margin="0,12,0,0" Padding="12">
        <StackPanel>
          <TextBlock x:Name="VersionText" FontWeight="SemiBold"/>
          <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" AutomationProperties.Name="Update status"/>
          <ProgressBar x:Name="UpdateProgress" Margin="0,6,0,0" Height="3" Minimum="0" Maximum="100" Visibility="Collapsed"/>
          <WrapPanel Margin="0,8,0,0">
            <Button x:Name="CheckUpdateButton" Click="CheckUpdate_Click" Content="Check for Updates"/>
            <Button x:Name="RestartUpdateButton" Style="{StaticResource PrimaryAction}" Margin="8,0,0,0" Click="RestartUpdate_Click" Content="Restart to Update" Visibility="Collapsed"/>
          </WrapPanel>
          <Expander x:Name="CreditsExpander" Header="License and credits" Margin="0,10,0,0" IsExpanded="False" HorizontalContentAlignment="Stretch">
            <StackPanel Margin="0,8,0,0">
              <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Text="GPL-3.0-or-later. No warranty. Redistribution is allowed under the included LICENSE."/>
              <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                Forked from GoLiveBypass by bezumiya and contributors. <Hyperlink NavigateUri="https://github.com/insxnsive/brisa" RequestNavigate="Source_RequestNavigate">Source and license</Hyperlink>
              </TextBlock>
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
