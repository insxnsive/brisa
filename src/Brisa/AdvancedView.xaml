<UserControl x:Class="Brisa.AdvancedView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Brisa.Localization"
        FocusVisualStyle="{x:Null}"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <!-- A página rola: com os créditos abertos o conteúdo passa da altura mínima da janela, e sem
       rolagem o botão de atualização saía da vista. -->
  <!-- A barra do Fluent flutua sobre o conteúdo. O ScrollViewer ocupa também a margem direita da
       página e o conteúdo devolve essa margem como padding: a barra cai no vazio à direita e as
       margens ficam iguais dos dois lados, com ou sem rolagem. -->
  <ScrollViewer Margin="0,0,-24,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,24,0">
      <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Loc AdvancedSubtitle}"/>
      <WrapPanel Margin="0,16,0,0">
        <Button x:Name="ImportButton" Click="Import_Click" ToolTip="{loc:Loc ImportTooltip}">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8E5;" VerticalAlignment="Center"/><TextBlock Margin="8,0,0,0" Text="{loc:Loc ImportConfiguration}"/></StackPanel>
        </Button>
        <Button x:Name="LogButton" Margin="8,0,0,0" Click="GenerateLog_Click" Content="{loc:Loc GenerateLog}"/>
      </WrapPanel>
      <!-- O log é só isto: os bytes que o backend produziu, sem a interface remontar linha nenhuma.
           Salvar e copiar ficam desabilitados até existir um log, para não gerar arquivo vazio. -->
      <!-- Sem barra horizontal: o texto quebra, então nada fica escondido à direita do usuário.
           A altura é de umas dez linhas e a página rola, para o cabeçalho inteiro caber. -->
      <TextBox x:Name="LogBox" Margin="0,12,0,0" Height="176" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               FontFamily="Cascadia Mono, Consolas" FontSize="12" AutomationProperties.Name="{loc:Loc LogBox}" Text="{loc:Loc NoLogGenerated}"/>
      <WrapPanel Margin="0,6,0,0">
        <Button x:Name="SaveLogButton" Click="SaveLog_Click" Content="{loc:Loc SaveLog}" IsEnabled="False" MinWidth="90"/>
        <Button x:Name="CopyLogButton" Margin="8,0,0,0" Click="CopyLog_Click" Content="{loc:Loc CopyLog}" IsEnabled="False" MinWidth="90"/>
        <TextBlock x:Name="LogNotice" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                   Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite" Text=""/>
      </WrapPanel>
      <!-- Versão, atualização e créditos moram aqui: são informação sobre o app, não uma
           preferência, e Settings fica só com o que o usuário escolhe. -->
      <Border Style="{StaticResource SettingsSurface}" Margin="0,12,0,0" Padding="12">
        <StackPanel>
          <TextBlock x:Name="VersionText" FontWeight="SemiBold"/>
          <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" AutomationProperties.Name="{loc:Loc UpdateStatus}"/>
          <ProgressBar x:Name="UpdateProgress" Margin="0,6,0,0" Height="3" Minimum="0" Maximum="100" Visibility="Collapsed"/>
          <WrapPanel Margin="0,8,0,0">
            <Button x:Name="CheckUpdateButton" Click="CheckUpdate_Click" Content="{loc:Loc CheckForUpdates}"/>
            <Button x:Name="RestartUpdateButton" Style="{StaticResource PrimaryAction}" Margin="8,0,0,0" Click="RestartUpdate_Click" Content="{loc:Loc RestartToUpdate}" Visibility="Collapsed"/>
          </WrapPanel>
          <Expander x:Name="CreditsExpander" Header="License and credits" Margin="0,10,0,0" IsExpanded="False" HorizontalContentAlignment="Stretch">
            <StackPanel Margin="0,8,0,0">
              <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Text="GPL-3.0-or-later. No warranty. Redistribution is allowed under the included LICENSE."/>
              <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                Forked from GoLiveBypass by bezumiya and contributors. <Hyperlink NavigateUri="https://github.com/insxnsive/brisa" RequestNavigate="Source_RequestNavigate">Source and license</Hyperlink>
              </TextBlock>
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
