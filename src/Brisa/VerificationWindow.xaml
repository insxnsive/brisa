<Window x:Class="Brisa.VerificationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verify your account" Width="460" Height="610" MinWidth="420" MinHeight="520" WindowStartupLocation="CenterOwner">
  <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="4,0,4,12"><TextBlock FontSize="20" FontWeight="SemiBold" Text="Verification required"/><TextBlock Margin="0,5,0,0" Opacity=".72" TextWrapping="Wrap" Text="Complete the Proton verification below. This temporary browser is isolated from the rest of the app."/></StackPanel>
    <Border Grid.Row="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
      <wv2:WebView2 x:Name="Browser" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"/>
    </Border>
    <Grid Grid.Row="2" Margin="0,12,0,0"><Button HorizontalAlignment="Right" Content="Cancel" Click="Cancel_Click"/></Grid>
  </Grid>
</Window>
